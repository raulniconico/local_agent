# Which backend drives the agent: "vllm" (local GPU) or "anthropic" (Claude API)
LLM_PROVIDER=vllm

# --- ANTHROPIC_API_KEY: required for LLM_PROVIDER=anthropic, and also for
# the coffee tools' image OCR (coffee_tools.py) regardless of LLM_PROVIDER,
# since that's a direct Claude API call rather than a turn of the chat model. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_OCR_MODEL=claude-opus-5

# --- Qwen: set both to use Qwen instead of Claude for the main chat model
# under LLM_PROVIDER=anthropic (falls back to Claude if either is empty).
# Not a separate LLM_PROVIDER value -- see graph.py build_llm(). Doesn't
# affect the coffee tools' image OCR, which always uses Claude directly. ---
QWEN_API_KEY=
QWEN_MODEL=
QWEN_MAX_TOKENS=8192
# Mainland China accounts: https://dashscope.aliyuncs.com/compatible-mode/v1
# International accounts:  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- LLM_PROVIDER=vllm ---
# Model to serve with vLLM (must match what setup.sh downloaded)
MODEL_ID=meta-llama/Llama-3.2-3B-Instruct
SERVED_MODEL_NAME=local-llama

# vLLM OpenAI-compatible server
VLLM_PORT=8000
VLLM_BASE_URL=http://localhost:8000/v1

# Sandbox root the agent's file tools are restricted to
AGENT_WORKSPACE=~/Documents

# --- USB sync with the Android app (coffee_agent/usb_sync.py) ---------------
# Both optional. ADB_PATH is auto-detected from PATH, then from
# ~/android-sdk/platform-tools/adb -- set it only if you have several SDKs
# installed and the wrong adb wins. ANDROID_PACKAGE only changes if you build
# the app under a different application id.
ADB_PATH=
ANDROID_PACKAGE=app.coffeecan

# Only needed once, for `huggingface-cli login` during setup.sh
HF_TOKEN=