# Which backend drives the agent: "vllm" (local GPU) or "anthropic" (Claude API)
LLM_PROVIDER=vllm

# --- ANTHROPIC_API_KEY: required for LLM_PROVIDER=anthropic, and also for
# the coffee tools' image OCR (app/coffee_tools.py) regardless of LLM_PROVIDER,
# since that's a direct Claude API call rather than a turn of the chat model. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_OCR_MODEL=claude-opus-5

# --- LLM_PROVIDER=vllm ---
# Model to serve with vLLM (must match what setup.sh downloaded)
MODEL_ID=meta-llama/Llama-3.2-3B-Instruct
SERVED_MODEL_NAME=local-llama

# vLLM OpenAI-compatible server
VLLM_PORT=8000
VLLM_BASE_URL=http://localhost:8000/v1

# Sandbox root the agent's file tools are restricted to
AGENT_WORKSPACE=~/Documents

# Only needed once, for `huggingface-cli login` during setup.sh
HF_TOKEN=