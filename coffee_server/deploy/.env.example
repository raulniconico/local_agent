# Copy this to deploy/.env and fill it in -- deploy.sh sources it. This is
# local deploy-time config (which instance, which key file on your machine);
# it never gets copied to the server, unlike ../.env (the app's own secrets,
# which deploy.sh does copy over separately).

# Name of the EC2 key pair *as registered in AWS* (not a file path) --
# create it in the EC2 console/CLI with file format "pem", per coffee_server's
# README. Must be a fresh key pair created with format=pem; a .ppk-format
# pair's private key can't be re-downloaded in pem form after creation.
KEY_NAME=

# Path to that key pair's downloaded .pem file on this machine.
KEY_FILE=~/Downloads/coffee-server-key.pem

# AWS region to deploy into. Defaults to whatever `aws configure` has set if left empty.
AWS_REGION=

# Free-tier eligible; fine for a single FastAPI/uvicorn process. Raise if you
# expect real traffic.
INSTANCE_TYPE=t3.micro

# Tag used to find/reuse the instance and security group across re-runs --
# change this if you want deploy.sh to manage a second, independent instance.
INSTANCE_NAME=coffee-server

# Port the container listens on and that gets opened to the internet.
APP_PORT=8000
