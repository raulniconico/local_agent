# Shared secret clients must send in the X-API-Key header. Required -- the
# server refuses to start without it (see main.py's startup check).
SERVER_API_KEY=

# The catalogue/news key. Falls back to SERVER_API_KEY when empty. Split so a
# rotation forced by one of them does not take the other's endpoints down.
READ_API_KEY=

# Comma-separated allowed CORS origins, or "*" for any (default). Safe as "*"
# since auth is a header the client sets explicitly, not a cookie.
ALLOWED_ORIGINS=*

# --- Accounts (required by the Android client) ---------------------------
# Comma-separated OAuth *web* client IDs. Google ID tokens are verified against
# these as the audience. EMPTY FAILS CLOSED: /v1/suggest, /v1/vision and
# /v1/account all return 503, because serving paid calls to unauthenticated
# callers is the exact failure the check exists to prevent.
GOOGLE_CLIENT_IDS=
# Holds the account records (Google sub, counters, quota, ban flag). Never user
# content -- see accounts.py.
ACCOUNT_DB_PATH=

# Per-account abuse cutoffs, not product limits: normal use hits none of them.
DAILY_QUOTA_ASK=60
DAILY_QUOTA_SUGGEST=60
DAILY_QUOTA_VISION=40
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=6

# --- Catalogue & news crawler --------------------------------------------
# OFF by default, and that is a compliance position rather than a default to
# flip: specs/legal.md rules 2-3 (outreach, 14-day wait, per-domain allowlist)
# and specs/legal-accounts.md rule 72 are unmet. Setting this to 1 with an
# empty allowlist.json still crawls nothing.
CRAWLER_ENABLED=
CRAWLER_ALLOWLIST_PATH=
CATALOGUE_TTL_SECONDS=86400
NEWS_TTL_SECONDS=7200
# specs/legal.md rule 17: truthful and contactable. Rule 18: never a browser UA.
CRAWLER_USER_AGENT=CoffeeBeanIndexBot/0.1 (+https://coffeecan.app/bot; bot@coffeecan.app)
CRAWLER_CONTACT_EMAIL=bot@coffeecan.app

# Port uvicorn listens on inside the container.
PORT=8000

# --- Anthropic (Claude). Leave ANTHROPIC_API_KEY empty to disable this provider. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8192
# The OCR model, separate on purpose so it can move independently of the chat one.
ANTHROPIC_VISION_MODEL=claude-opus-5

# --- Qwen (Alibaba DashScope, OpenAI-compatible). Leave QWEN_API_KEY empty to disable. ---
QWEN_API_KEY=
QWEN_MODEL=qwen-max
QWEN_MAX_TOKENS=8192
# Mainland China accounts: https://dashscope.aliyuncs.com/compatible-mode/v1
# International accounts:  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Vision needs an omni model; the chat one cannot do it.
QWEN_VISION_MODEL=qwen3.5-omni-flash
# Cap on a decoded /v1/vision image (bytes). 6 MB is far past what a label needs.
MAX_IMAGE_BYTES=6291456
